<launch>
  <arg name="audio_device" default="default" />
  <arg name="tts_model_dir" default="" />
  <node pkg="uav_audio" type="audio_node" name="audio_node" output="screen">
    <param name="audio_device" value="$(arg audio_device)" />
    <param name="tts_model_dir" type="str" value="$(arg tts_model_dir)" />
  </node>
</launch>
